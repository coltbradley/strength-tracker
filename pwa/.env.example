# Supabase project (required)
# NOTE: the Supabase "Magic Link" email template must include {{ .Token }}
# alongside the link — the login screen's 6-digit code fallback (needed for
# installed iOS PWAs, where the link opens in partitioned Safari storage)
# depends on it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional locally, set by CI for the deployed build (see
# .github/workflows/deploy.yml). Unset, error reporting is console + toast
# only and the in-app "report a problem" button says so instead of pretending
# it filed something.
VITE_SENTRY_DSN=

# Optional build stamp, set by CI. The About row and every bug report quote
# these; unset they fall back to the package version with no commit.
VITE_APP_VERSION=
VITE_BUILD_SHA=
VITE_BUILD_TIME=
